import tkinter as tk
from tkinter import ttk, messagebox

class BusinessGameHub:
    def __init__(self, root):
        self.root = root
        self.root.title("AI Games Zone | Desktop Suite")
        self.root.geometry("1000x700")
        
        # Color Palette: Deep Blue and Vibrant Purple
        self.bg_main = "#0f0c29"    # Dark space blue
        self.accent_purple = "#6a11cb" 
        self.accent_blue = "#2575fc"
        self.text_color = "#e0e0e0"

        self.root.configure(bg=self.bg_main)

        # Main Header
        self.header_frame = tk.Frame(self.root, bg=self.bg_main)
        self.header_frame.pack(fill="x", pady=40)

        self.title_label = tk.Label(
            self.header_frame, 
            text="AI GAMES ZONE", 
            font=("Segoe UI", 40, "bold"),
            fg=self.accent_blue,
            bg=self.bg_main
        )
        self.title_label.pack()

        self.subtitle = tk.Label(
            self.header_frame,
            text="10 Premium AI Experiences Integrated",
            font=("Segoe UI", 12),
            fg=self.accent_purple,
            bg=self.bg_main
        )
        self.subtitle.pack()

        # Game Grid Container
        self.grid_frame = tk.Frame(self.root, bg=self.bg_main)
        self.grid_frame.pack(expand=True, padx=50, pady=20)

        # Defining our 10 Games
        self.games = [
            "AI Shooter", "World Creator", "Neural Racer", 
            "Logic Gate", "Vortex Jump", "Cyber Quest", 
            "Pixel Builder", "Bot Combat", "Space Dodge", "Mind Maze"
        ]

        self.render_game_grid()

    def render_game_grid(self):
        """Creates a professional 3x4 grid for game selection."""
        row, col = 0, 0
        for game in self.games:
            # Game Card Style
            card = tk.Button(
                self.grid_frame, 
                text=game,
                font=("Segoe UI", 12, "bold"),
                width=18,
                height=4,
                bg="#16213e", # Card Blue
                fg=self.text_color,
                bd=2,
                relief="flat",
                activebackground=self.accent_purple,
                cursor="hand2",
                command=lambda g=game: self.start_game(g)
            )
            card.grid(row=row, column=col, padx=15, pady=15)
            
            # Button Hover Effects (Basic)
            card.bind("<Enter>", lambda e, c=card: c.config(bg=self.accent_blue))
            card.bind("<Leave>", lambda e, c=card: c.config(bg="#16213e"))

            col += 1
            if col > 2:
                col = 0
                row += 1

    def start_game(self, name):
        """Handles the execution logic for the selected game."""
        messagebox.showinfo("System Update", f"Booting {name} Engine...\nAI Models Loading...")

if __name__ == "__main__":
    root = tk.Tk()
    app = BusinessGameHub(root)
    root.mainloop()
